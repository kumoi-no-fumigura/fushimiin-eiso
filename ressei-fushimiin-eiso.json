 ],
 "poems": [
  {
   "seq": "1",
   "text": "おのづからもとめぬ友は山陰にありけるものをはな鳥のやど",
   "kana": "",
   "speaker": "",
   "page": 33,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "あはれなる野山の草木それだにも誰が〓へたる春にかあるらむ〓",
   "kana": "",
   "speaker": "",
   "page": 33,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "軒ふかき花のかをりに空とぢて木の間わづかにあくる月かげ",
   "kana": "",
   "speaker": "",
   "page": 33,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "花のなかに春をいそぐがうれしきに軒近くしも梅の咲きける",
   "kana": "",
   "speaker": "",
   "page": 33,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "何となく春のひぐれぞあはれなる霞のきはにとりわたりつつ",
   "kana": "",
   "speaker": "",
   "page": 34,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "梅かをり月うすがすむおぼろ夜に春のあはれぞおほくこもれる",
   "kana": "",
   "speaker": "",
   "page": 34,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "ゆふぐもり雲にかすみの立ちそひて幾重かとづる春雨のそら",
   "kana": "",
   "speaker": "",
   "page": 34,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "それもいまぞ忘るな雁の一つらよあき風たたむ夕ぐれのそら",
   "kana": "",
   "speaker": "",
   "page": 34,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "ほのぼのと峯のかすみは匂ひそめて軒端の花にあけつたふなり",
   "kana": "",
   "speaker": "",
   "page": 34,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "空ははや色わかぬまでくれはてて庭に殘れるはるさめのおと",
   "kana": "",
   "speaker": "",
   "page": 34,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "年年のわかれもおなじ春ならばをしみなれぬるあはれをや思ふ",
   "kana": "",
   "speaker": "",
   "page": 34,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "あはれなり知らで惜まぬ人の世よ春はひかずのあればこそあれ",
   "kana": "",
   "speaker": "",
   "page": 34,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "春はせめておなじ時にもなぐさまむ又あはぬ世の人ぞかなしき",
   "kana": "",
   "speaker": "",
   "page": 34,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "春を惜む今宵の友もつひにそれさり別るべき限はあるらむ",
   "kana": "",
   "speaker": "",
   "page": 34,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "はるを惜む心にあはれつづききてなみだにほひて思ふことあり",
   "kana": "",
   "speaker": "",
   "page": 34,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "見ずならむ春までかねて悲しきはこころをそむる雲の上の花",
   "kana": "",
   "speaker": "",
   "page": 34,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "岩木まで名殘とならぬものもなし別にむけてはるをおもへば",
   "kana": "",
   "speaker": "",
   "page": 34,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "まぎれすごし思ひもいれぬ悲しさよさしもあひ難き時の情を",
   "kana": "",
   "speaker": "",
   "page": 34,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "花のあとの靑葉にかはる色を見てものうらめしみ春やゆくらむ",
   "kana": "",
   "speaker": "",
   "page": 34,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "時をしたひ人を思ふもすべて世に別てふことぞかなしかりける",
   "kana": "",
   "speaker": "",
   "page": 34,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "春はそれかならずかへる時もあらむ長きわかれは人の身ぞうき",
   "kana": "",
   "speaker": "",
   "page": 34,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "かたちなき春の名殘を思ひつけて惜みしたふぞせめてはかなき",
   "kana": "",
   "speaker": "",
   "page": 35,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "散りはてて花はもとより殘らぬを名のみ名殘の春にぞありける",
   "kana": "",
   "speaker": "",
   "page": 35,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "今いく夜かすみ殘れる有明の月をなごりのはるのおほぞら",
   "kana": "",
   "speaker": "",
   "page": 35,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "をしまれてとまるも何かしるしならむ春てふ色の形なければ",
   "kana": "",
   "speaker": "",
   "page": 35,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "鶯は時となけども梅が枝にゆきちりかかるはなはつれなし",
   "kana": "",
   "speaker": "",
   "page": 35,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "のどかなるゆふべのながめはるにして音せぬ雨の暮ぞ淋しき",
   "kana": "",
   "speaker": "",
   "page": 35,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "咲きそむる一木の花とみる程に四方の櫻もさかりにぞなる",
   "kana": "",
   "speaker": "",
   "page": 35,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "よもやまに白雲みてり昨日今日花のさかりに匂ふなるべし",
   "kana": "",
   "speaker": "",
   "page": 35,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "花の上はなほ色そひてゆふぐれの梢のそらぞ深くかすめる",
   "kana": "",
   "speaker": "",
   "page": 35,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "いろいろの藤山吹の花ざかりなどしも春のくれにあふらむ",
   "kana": "",
   "speaker": "",
   "page": 35,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "ひととせにただ一時の春にだになほさきだたぬ花ぞかなしき",
   "kana": "",
   "speaker": "",
   "page": 35,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "ひととせはみな春ながら過ぎななむのどかに花の色を見るべく",
   "kana": "",
   "speaker": "",
   "page": 35,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "山里の花に心をうつしとめてかへらむかたのいそがれぬかな",
   "kana": "",
   "speaker": "",
   "page": 35,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "かすみわたる遠つ山べの春のくれ何のもよほすあはれともなき",
   "kana": "",
   "speaker": "",
   "page": 35,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "晴れはてぬ雨のなごりの雲なれやうすくかすめる夕暮のやま",
   "kana": "",
   "speaker": "",
   "page": 35,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "櫻花にほひのうちにいくはるのひとのなさけをそめかもつらむ",
   "kana": "",
   "speaker": "",
   "page": 35,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "をりふしは散るしもなほの情かな風のこずゑのゆふぐれの花○",
   "kana": "",
   "speaker": "",
   "page": 35,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "待ちとらむいづくの春を急ぎてか惜むところにとまりしもせぬ",
   "kana": "",
   "speaker": "",
   "page": 35,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "ながめしをる彌生のすゑの雨の中に花もなごりと散り亂れつつ",
   "kana": "",
   "speaker": "",
   "page": 35,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "山吹の花のさかりを待つほどにはるの日數のすぎぬべきかな",
   "kana": "",
   "speaker": "",
   "page": 36,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "花はちり春はかへれどあぢきなきわが身は何となる方もなし",
   "kana": "",
   "speaker": "",
   "page": 36,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "いづかたにわれもと思ふ世の中をうたても春のひとりさる哉",
   "kana": "",
   "speaker": "",
   "page": 36,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "雲の上の花はかはらず匂ふともまた見む春はいさ知らぬ身を",
   "kana": "",
   "speaker": "",
   "page": 36,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "思ふ故のなきにしもあらぬ名殘をばあはれと思へ雲の上の春",
   "kana": "",
   "speaker": "",
   "page": 36,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "この雨にふりめぐまれてまたれつる梢の花の明日やひらけむ",
   "kana": "",
   "speaker": "",
   "page": 36,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "かくにほふ花しあらずばやすらはで春の山路はいなまし物を○",
   "kana": "",
   "speaker": "",
   "page": 36,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "見るままに綠ぞまさるとほつ川岸のやなぎのはるさめのくれ",
   "kana": "",
   "speaker": "",
   "page": 36,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "散りぬべき花の心にしたがへばさそふ風のみのうきにしもなし",
   "kana": "",
   "speaker": "",
   "page": 36,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "月影はねざめの床にのこりつつ花のかをりぞまどをあらそふ",
   "kana": "",
   "speaker": "",
   "page": 36,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "春はげにきたりもさりもせぬものを何をかたちの今日の別ぞ○",
   "kana": "",
   "speaker": "",
   "page": 36,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "わかるるも惜むもひとつ心よりさまざまになす今日の春哉",
   "kana": "",
   "speaker": "",
   "page": 36,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "同じ春ののちもあるべき物ならばなにかは今日の別なるべき",
   "kana": "",
   "speaker": "",
   "page": 36,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "あたらよのわが身のはての悲しさよ盛ほどなき花をみるにも",
   "kana": "",
   "speaker": "",
   "page": 36,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "のどかなる眺やほかにまさるらむ春はかすみの九重のうち",
   "kana": "",
   "speaker": "",
   "page": 36,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "夕暮のひさしくあるとおぼえつるは霞む春日の長きなりけり",
   "kana": "",
   "speaker": "",
   "page": 36,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "あくがるる心も人はおもひやらじ霞める月のさよふかきそら",
   "kana": "",
   "speaker": "",
   "page": 37,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "待ちをしみ雲井の花をながめてもあはれ十年の春は過ぎにき○",
   "kana": "",
   "speaker": "",
   "page": 37,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "櫻花まつとをしむといくたびの春のながめにあはむとかする",
   "kana": "",
   "speaker": "",
   "page": 37,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "忘れじなやよひのなかば空すみて月さやかなる春のこよひを",
   "kana": "",
   "speaker": "",
   "page": 37,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "めぐり逢はばまたもと賴む春なれど知り難き世の我れぞはかなき",
   "kana": "",
   "speaker": "",
   "page": 37,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "かくてまためぐり逢はむもかたき世に今宵の春よげに惜むべし○",
   "kana": "",
   "speaker": "",
   "page": 37,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "今の友おなじ情のうちにしてまためぐりあふ春もやあるらむの",
   "kana": "",
   "speaker": "",
   "page": 37,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "命ありて今宵にまたもめぐりあはば今の情をいかにしのばむ",
   "kana": "",
   "speaker": "",
   "page": 37,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "いかなれや常の別の春よりもこころぼそさのこよひそひぬる",
   "kana": "",
   "speaker": "",
   "page": 37,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "おしなべて池のあたりは靑みわたり春深げなる色になりぬる",
   "kana": "",
   "speaker": "",
   "page": 37,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "さかりなる汀の花のくれの色をこころとどめて今日ぞ眺むる",
   "kana": "",
   "speaker": "",
   "page": 37,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "ひびき匂ふ霞のうちの入相のこゑもはるなるいまのゆふぐれ",
   "kana": "",
   "speaker": "",
   "page": 37,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "花ははやさかり過ぎたるこずゑしも今日は情とながめなしぬる",
   "kana": "",
   "speaker": "",
   "page": 37,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "かすみはつる夕の空を見るままにこころに深きあはれぞにほふ",
   "kana": "",
   "speaker": "",
   "page": 37,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "日にそへてさてあらまうき世の中に羨ましくもかへる春かな",
   "kana": "",
   "speaker": "",
   "page": 37,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "恨むべき風のつらさを我れになして花ふみちらす宿のうぐひす",
   "kana": "",
   "speaker": "",
   "page": 37,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "今年だにあくまで花にまかせてむ身をいたづらの春のいとまを○",
   "kana": "",
   "speaker": "",
   "page": 37,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "うつろひし雲井のやどのさくら花またかはる世の春ぞ程なき",
   "kana": "",
   "speaker": "",
   "page": 37,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "思ひいでてなほこそしのべ諸人のさくらかざしし雲の上の春",
   "kana": "",
   "speaker": "",
   "page": 37,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "春にかはる心はなしにあしびきの山のかすみの立つをしぞみる",
   "kana": "",
   "speaker": "",
   "page": 37,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "いたづらに時しもわかぬ春の雪のすさまじき世に我れぞありふる",
   "kana": "",
   "speaker": "",
   "page": 37,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "時知らぬ身はふるさとの雪の中に春めづらしきうぐひすの聲",
   "kana": "",
   "speaker": "",
   "page": 37,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "なぞやこの梅てふ花のありそめて色香に人のこころのみとる",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "うち霞み時のあはれやいまならむ月としもなき朧夜のはる",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "うかるべき春の別にあはじとてさきだつ花もこころありけり",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "いづかたのなごりかなほも勝るらむ花と春とのおなじ別は",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "うちなびく柳さくらのいろいろも春のさかりと見ゆるころ哉",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "なべて皆みちゆき人の氣色まで花にのみあるきさらぎのころ",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "思ひおく心の色も知らぬ人の花をかたみと見ざらむもうし",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "霞む夜の木の間の空はおぼろにて花にかをれるはるの月かげ",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "春のくれ空もなごりを惜みてや雲もしをれてあめの降るらむ",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "靜かなるながめもいとどかなしきは春もいまはの夕暮のあめ",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "うちなびく氣色をみれば靑柳の絲にし春はくるにぞありける",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "春雨はみどりの絲に露ぬきてたまやなぎとはむべもいひけり",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "91",
   "text": "うぐひすの聲も匂ひてきこゆるは花のなかにてなけばなるらむ",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "92",
   "text": "山陰の垣根は春にうとくあれやこぞみしままの雪ぞかはらぬ",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "93",
   "text": "かすみわたる山邊をみてや鶯のわがとききぬと谷を出づらむ",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "94",
   "text": "山ざくらをしまぬ風のこころには誘ひちらすを情とやおもふ",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "95",
   "text": "春の色は霞のすゑのおく深みながめこめぬるきさらぎの野邊",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "96",
   "text": "をちかたの柳の上に雨はれてまきしづかなるはるのやまもと",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "97",
   "text": "ともし火のひかりふけたる春の夜はおしあくる窓も月ぞ霞める",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "98",
   "text": "あけぼのやただかすみなる波の上はま近き舟ぞゆききをも見る",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "99",
   "text": "見えそむる木の間をあくる色にして花にとぢたる窓のしののめ",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "100",
   "text": "思ひかぬるもとのうれへに今よりの秋の心をなほやくはへむ",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "101",
   "text": "星あひは雲のうへにて目の前のわかれを人になげくころかな",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "102",
   "text": "秋ふかみ尾花がすゑも霜がれぬゆふべの風はもの寒くして",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "103",
   "text": "あさあけや雨の曇と見えつるはまだ霧晴れぬ空にぞありける",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "104",
   "text": "たちさわぎしばしぞはれぬ橫雲のなごりの山の霧のむらむら",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "105",
   "text": "秋風のたかき岡邊の柳かげなびくこずゑにゆふ日をぞみる",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "106",
   "text": "むすびかへむ淺茅が露の玉くしげふた夜あけなば冬のはつ霜",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "107",
   "text": "この頃のうき世を秋の心しるや雲井のかりも音をぞともなふ",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "108",
   "text": "片岡の梢のかぜに一葉おちてあきなるくれのひぐらしのこゑ",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "109",
   "text": "草の露松のあらしもすめる夜の月よりなれるあはれとぞ思ふ",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "110",
   "text": "今よりのましての空よゆふぐれは秋ならでだにながめし物を",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "111",
   "text": "難波がたあしのいく夜もまだへぬに秋立ちぬとや風の凉しき",
   "kana": "",
   "speaker": "",
   "page": 40,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "112",
   "text": "秋にあくるあしたの原の風の音にやがてや露もこぼれそむらむ",
   "kana": "",
   "speaker": "",
   "page": 40,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "113",
   "text": "たなばたの逢ふ夜近しとあまの川空にすずしき風わたるなり",
   "kana": "",
   "speaker": "",
   "page": 40,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "114",
   "text": "月の色雲のけしきもこのゆふべ秋になりぬと見えそめぬなり",
   "kana": "",
   "speaker": "",
   "page": 40,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "115",
   "text": "はかなくてうき初秋のひとめぐり露をそへぬるふかくさの里",
   "kana": "",
   "speaker": "",
   "page": 40,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "116",
   "text": "秋たけて寒き淺茅がつゆの上にひかりふけたるありあけの月",
   "kana": "",
   "speaker": "",
   "page": 40,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "117",
   "text": "こぬ人を垣ほのまくずうらみかねおのれ枯れゆく秋のふる里",
   "kana": "",
   "speaker": "",
   "page": 40,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "118",
   "text": "ながめやるふしみの田の面すゑこめてあけぼの深き宇治の川霧",
   "kana": "",
   "speaker": "",
   "page": 40,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "119",
   "text": "過ぎきつる月の秋だにほどもなしまして今よりゆくすゑの空",
   "kana": "",
   "speaker": "",
   "page": 40,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "120",
   "text": "ありあけのかたぶくかたの鐘の聲枕そばだてながめてぞきく",
   "kana": "",
   "speaker": "",
   "page": 40,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "121",
   "text": "草はつゆ袖はなみだのゆふまぐれ秋にしをれぬ世の色もなし",
   "kana": "",
   "speaker": "",
   "page": 40,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "122",
   "text": "よそになく蟲のうらみと聞くほどに我れもうれへの心にぞなる",
   "kana": "",
   "speaker": "",
   "page": 40,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "123",
   "text": "吹きはらふ嵐の庭に音をさせて木の葉にかろき秋のむらさめ",
   "kana": "",
   "speaker": "",
   "page": 40,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "124",
   "text": "秋ふかき霧のくもりのあさけより晴れもつづかぬ雨となりぬる",
   "kana": "",
   "speaker": "",
   "page": 41,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "125",
   "text": "枯れはつる草葉もなほぞしをれゆくさむき雨ふるあきのくれがた",
   "kana": "",
   "speaker": "",
   "page": 41,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "126",
   "text": "風まよふ野分の草の上あれてよこぎる雨はつゆもたまらず",
   "kana": "",
   "speaker": "",
   "page": 41,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "127",
   "text": "聞くままにくらき雨のみふりそひて人はおとせぬ秋のよの窓○",
   "kana": "",
   "speaker": "",
   "page": 41,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "128",
   "text": "身をあきのうれへをうつすよもの色に月もおちてや影の悲しき",
   "kana": "",
   "speaker": "",
   "page": 41,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "129",
   "text": "浮雲にむかふは早き月かげのはれ間のそらはのどかにぞすむ",
   "kana": "",
   "speaker": "",
   "page": 41,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "130",
   "text": "おきしめる夜寒の露の袖うすみひかりもおもき月のころもで",
   "kana": "",
   "speaker": "",
   "page": 41,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "131",
   "text": "秋の月はねざめの窓をすぎてまくらにおつるかげぞふけぬる",
   "kana": "",
   "speaker": "",
   "page": 41,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "132",
   "text": "庭くらくかたぶく月はかべにみちてなく養こゑふけにけり",
   "kana": "",
   "speaker": "",
   "page": 41,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "133",
   "text": "あけやする光をしける庭の月のかげとしもなくうすくなりゆく",
   "kana": "",
   "speaker": "",
   "page": 41,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "134",
   "text": "秋のあさけ霧たちまがひふる雨にしられでぬるる草の上かな",
   "kana": "",
   "speaker": "",
   "page": 41,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "135",
   "text": "三日月のありあけのかげになるまでに秋の幾夜を眺めきぬらむ",
   "kana": "",
   "speaker": "",
   "page": 41,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "136",
   "text": "蟲の聲のかれゆくきけばおしなべて見ぬ山までの秋ぞ知らるる",
   "kana": "",
   "speaker": "",
   "page": 41,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "137",
   "text": "秋に見むそのおもかげも今いく夜よをへて細きありあけの月",
   "kana": "",
   "speaker": "",
   "page": 41,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "138",
   "text": "山の端のいるかた近くみゆるかなまだ弓張のよひのまのつき",
   "kana": "",
   "speaker": "",
   "page": 41,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "139",
   "text": "人はこずはしにしたたる秋の雨を空しきとこに聞きあかす哉",
   "kana": "",
   "speaker": "",
   "page": 41,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "140",
   "text": "秋風の寒き岡邊のやなぎかげすさまじき世のいろになりぬる",
   "kana": "",
   "speaker": "",
   "page": 42,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "141",
   "text": "いくつらぞあけやらぬ空は見えわかで霧にかきけつ雁の玉章",
   "kana": "",
   "speaker": "",
   "page": 42,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "142",
   "text": "眞萩原枯葉まばらにちりすぎてあれたる庭のあきのくれがた",
   "kana": "",
   "speaker": "",
   "page": 42,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "143",
   "text": "昔とておもひきはむるはてもなし過ぎけむ空のあきのよの月",
   "kana": "",
   "speaker": "",
   "page": 42,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "144",
   "text": "はださむみ秋なる風のこよひかな月も身にしむ色にながめて",
   "kana": "",
   "speaker": "",
   "page": 42,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "145",
   "text": "久方の空てりきよみあきらけき秋の月夜は見れどあかぬかも○",
   "kana": "",
   "speaker": "",
   "page": 42,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "146",
   "text": "さびしげの秋のみやまのゆふぐれや梢にあらし雲にかりがね",
   "kana": "",
   "speaker": "",
   "page": 42,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "147",
   "text": "秋ならであきあはれなる眺かな月かげくもるむらさめのそら",
   "kana": "",
   "speaker": "",
   "page": 42,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "148",
   "text": "かげしげき木木のしづくに露おちて霧深き山のあけぼのの空",
   "kana": "",
   "speaker": "",
   "page": 42,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "149",
   "text": "もろこしの山を過ぎゆく秋なりとしたふ心のわれおくれめや",
   "kana": "",
   "speaker": "",
   "page": 42,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "150",
   "text": "秋風のこずゑにひびく夕暮に雲井のかりもこゑあはすなり",
   "kana": "",
   "speaker": "",
   "page": 42,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "151",
   "text": "垣ほなるまぐさが下葉色かれぬ夜寒もよほすあきかぜのころ",
   "kana": "",
   "speaker": "",
   "page": 42,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "152",
   "text": "同じ秋の月はかはらずめぐりあへど去年にかはれる哀をぞ思ふ",
   "kana": "",
   "speaker": "",
   "page": 42,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "153",
   "text": "あけぬやとねざめてきけば秋の夜のさもまだ深きかねの音哉",
   "kana": "",
   "speaker": "",
   "page": 42,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "154",
   "text": "ゆふやみや月をおそしとながむれば袂にふれて秋風ぞ吹く",
   "kana": "",
   "speaker": "",
   "page": 42,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "155",
   "text": "わけてゆく野原や遠くなりぬらし月かげおもる露のころもで",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "156",
   "text": "いでそむる月はよそなる光にてまだのきくらき松かぜのこゑ",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "157",
   "text": "かたぶかぬ月の光はよるながら鐘のこゑのみあけがたのそら",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "158",
   "text": "時雨にも風にもわきてもろかれやはやくそめちる櫨のもみぢば",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "159",
   "text": "いつもわが寐覺の空にめぐりあへな窓にむかへる入方の月",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "160",
   "text": "なまた露も淚もさそはれぬあはれことしも秋風のそで",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "161",
   "text": "ちらねどもまだきにさびし夕づく日さすや軒端の木木の秋風",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "162",
   "text": "かくてなほかはらぬ影もいつまでぞわがよ更けたる秋の燈火",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "163",
   "text": "今日といへば何の憂のそふとなみ秋としきくぞただに侘しき",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "164",
   "text": "色そはむながめよいかに今よりの草木の上も秋たちぬなり",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "165",
   "text": "露をおきて涙ぞしるき今よりのうれへの袖のあきのゆふぐれ",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "166",
   "text": "見なれぬる月はいづくもあきながらわが面影やあらずなりなむ",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "167",
   "text": "枯れわたる霜のまがきの秋の草かはる姿はわれひとりかは",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "168",
   "text": "はるばると雲の波路のすゑはれて月の夜わたる須磨の浦ぶね",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "169",
   "text": "もの思ふいつもの空の雲風も秋なるくれのいろをそふなり",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "170",
   "text": "鹿のこゑ蟲のうらみもうれへまさる秋にし心ひとりたへめや○",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "171",
   "text": "風の音の秋に吹き立つ夕よりころもでかけてつゆおちぬなり",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "172",
   "text": "秋ならぬ心になしてながむともなほ雲風のあはれやあるらむ",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "173",
   "text": "しかむしのうれへもからず秋はただ心よりして物ぞかなしき",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "174",
   "text": "雲井にはかりがねわたる夕ぐれにむらさめまがふ軒の松かぜ",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "175",
   "text": "露のいろ月の光もむしのねも野邊にみちたる秋のさよなか",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "176",
   "text": "散りぬなり岡邊のやどのはじ紅葉山の木の葉は染め果てぬまに",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "177",
   "text": "あま人もねてやあかしの浦づたひ月に夜ふねの音ぞきこゆる",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "178",
   "text": "いたづらにうき身よそぢの秋たけてわが世ふりぬる霜の蓬生",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "179",
   "text": "故〓や野邊ひとつなるあきかぜに葛の葉白きゆふぐれのには",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "180",
   "text": "露しろく月しづかにてさ夜ふくるよもぎが庭は秋風もなし○",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "181",
   "text": "軒ふかき松の葉かげをいでやらでしばしはほかに月ぞさやけき",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "182",
   "text": "しぐれゆく峯のこずゑの色ならで雲は夕日のそむるなりけり",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "183",
   "text": "初あきのうかりし月の面影もみとせをかけてまためぐりきぬ",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "184",
   "text": "いつしかの草木のうへはかくもあらじ心ぞたへぬ秋のはつ風",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "185",
   "text": "秋ぞとて咲きそむる花は見えながらおのが時まつ庭のはぎ原",
   "kana": "",
   "speaker": "",
   "page": 45,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "186",
   "text": "人の世ぞあはれはかなき草の上のつゆはきえても又結びけり",
   "kana": "",
   "speaker": "",
   "page": 45,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "187",
   "text": "星合は雲のよそにて目の前のわかれを人になげくころかな",
   "kana": "",
   "speaker": "",
   "page": 45,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "188",
   "text": "思ひかぬるもとのうれへに今よりの秋の心をなほやくはへむ",
   "kana": "",
   "speaker": "",
   "page": 45,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "189",
   "text": "さよもふけ人も靜まる時になりて月はひとりぞすみまさりける",
   "kana": "",
   "speaker": "",
   "page": 45,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "190",
   "text": "月の庭は更けしづまれる秋の夜にきりぎりすひとり鳴き勝るなり",
   "kana": "",
   "speaker": "",
   "page": 45,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "191",
   "text": "山里のまがきの草もうちしをれ霧にしめれるあけぼののいろ",
   "kana": "",
   "speaker": "",
   "page": 45,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "192",
   "text": "しばしこそこずゑもそれと眺めつれ霧になりゆくをちの一村",
   "kana": "",
   "speaker": "",
   "page": 45,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "193",
   "text": "なきてくる雲井のかりの聲すなり霧はれぬまのけさのあさけに",
   "kana": "",
   "speaker": "",
   "page": 45,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "194",
   "text": "草村のくらきまがきのよひの庭に月まつむしの聲しきりなり",
   "kana": "",
   "speaker": "",
   "page": 45,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "195",
   "text": "秋風の吹きすぎてゆく末みえて野澤の草にしぎたちぬなり",
   "kana": "",
   "speaker": "",
   "page": 45,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "196",
   "text": "たへずなる秋の心を風にうけてふるる草木もなべてかなしき",
   "kana": "",
   "speaker": "",
   "page": 45,
   "pid": "1088203",
   "form": "短歌",
   "genre": ""
  }
 ],
 "catalog": {
